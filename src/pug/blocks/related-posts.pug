mixin related-post(image, date, dateText, title, link = '#')
	article.related-posts__item.swiper-slide
		a.related-posts__link(href=link)
			.related-posts__image
				img(src=image, alt="", loading="lazy")
			time.related-posts__date(datetime=date)= dateText
			p.related-posts__name= title

section.related-posts
	.related-posts__container.container
		.related-posts__box.section-col
			
			h2.h2.related-posts__title Читайте в нашем блоге
			
			.slider-wrapper
				.related-posts__slider.swiper.js-related-posts
					.related-posts__list.swiper-wrapper

						+related-post(
							'assets/images/related-posts-01.jpg',
							'2026-05-24',
							'24 мая 2026',
							'Куда поехать в сентябре: 7 идей для бюджетных путешествий по России и не только'
						)

						+related-post(
							'assets/images/related-posts-02.jpg',
							'2026-05-24',
							'24 мая 2026',
							'Пешком по Тбилиси: мост-прищепка, дом-дженга и ещё 8 необычных мест'
						)

						+related-post(
							'assets/images/related-posts-03.jpg',
							'2026-05-24',
							'24 мая 2026',
							'Календарь школьных каникул 2026/2027: когда планировать семейный отдых',
							'/articles/school-holidays/'
						)
				.related-posts__nav.slider-nav
					.related-posts__nav-box.slider-nav__box
						.related-posts__prev.slider-nav__prev
						.related-posts__next.slider-nav__next
