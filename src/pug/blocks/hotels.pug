include ../mixins/hotel-item.pug
include ../mixins/tag-tour.pug
include ../mixins/badge-item.pug

section.hotels
	.hotels__container.container
		.hotels__box.section-grid
			.hotels-top
				h2.h2.hotels-title Отели по суперцене
				p.hotels-descr Самые выгодные предложения


			.hotels__slider-wrapper.slider-wrapper
				.hotels__slider.swiper.js-hotels-slider
					.hotels-list.swiper-wrapper

						+hotel-item(
							"assets/images/hotels-01.jpg",
							[
								{text: "-25%", icon: "lightning"},
								{text: "Рекомендуем", accent: true}
							],
							"Абхазия Гагры",
							"Дом отдыха",
							"Апсны-Абазашта",
							"от 14 880 ₽ / чел",
							"3 ночи"
						)

						+hotel-item(
							"assets/images/hotels-02.jpg",
							[
								{text: "-10%"}
							],
							"Сочи",
							"Гостиница",
							"Арстаа",
							"от 7 850 ₽ / чел",
							"12 ночей"
						)

						+hotel-item(
							"assets/images/hotels-03.jpg",
							[
								{text: "Рекомендуем", accent: true }
							],
							"Абхазия Гагры",
							"Отель",
							"Багрипш",
							"от 11 390 ₽ / чел",
							"5 ночей"
						)

						+hotel-item(
							"assets/images/hotels-04.jpg",
							[
								{text: "-10%"}
							],
							"Сочи",
							"База отдыха",
							"Холодная речка",
							"от 34 900 ₽ / чел",
							"7 ночей"
						)

						+hotel-item(
							"assets/images/hotels-01.jpg",
							[
								{text: "Горящий", accent: true, icon: 'fire'}
							],
							"Сочи",
							"Гостиница",
							"Арстаа",
							"от 7 850 ₽ / чел",
							"12 ночей"
						)

						+hotel-item(
							"assets/images/hotels-02.jpg",
							[
								{text: "-10%"}
							],
							"Сочи",
							"Гостиница",
							"Арстаа",
							"от 7 850 ₽ / чел",
							"12 ночей"
						)
						
				.hotels__nav.slider-nav
					.hotels__nav-box.slider-nav__box
						.hotels__prev.slider-nav__prev
						.hotels__next.slider-nav__next
			
			a.hotels__btn.btn.gray(href="#") 
				| Все отели
				svg.btn-icon(aria-hidden="true")
					use(href="assets/icons/symbol/sprite.svg#arrow-right")