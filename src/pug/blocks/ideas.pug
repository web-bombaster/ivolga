include ../mixins/badge-item.pug

mixin idea-item(image, title, badges, tags, price, link = '#', showMore = false)
	li.ideas-list__item.idea-item
		.idea-item__img
			img(src=image, alt="")
			if badges && badges.length
				.badges
					each badge in badges
						+badge-item(badge.text, badge.accent, badge.icon)

		.idea-item__info
			.idea-item__top
				p.idea-item__title= title

				.idea-item__tags
					each tag in tags
						a.idea-item__tag(href=tag.link || '#')= tag.text

					if showMore
						button.idea-item__tag.idea-item__tag--btn(type="button")
							| Еще
							svg(xmlns="http://www.w3.org/2000/svg", width="20", height="20", fill="none", viewBox="0 0 20 20")
								path(stroke="currentColor", stroke-width="1.778", d="m15 7.5-5 5-5-5")

			.idea-item__bottom
				span.idea-item__price= price
				a.idea-item__btn.btn.btn-fill(href=link) Подробнее

