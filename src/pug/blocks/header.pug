			.header-top__info
				.header-top__phones.ht-phones
					.ht-phones__item
						span Агентствам
						a(href="tel:+79885368511") +7 (988) 536 85 11
					.ht-phones__item
						span Агентствам
						a(href="tel:+79885368511") +7 (988) 536 85 11

				.header-top__social.soc-btns
					a.soc-btns__item.soc-btn(href="#" target="_blank" rel="noopener noreferrer" aria-label="Max")
						svg(aria-hidden="true").soc-btn__icon
							use(href="assets/icons/symbol/sprite.svg#max-mono")

					a.soc-btns__item.soc-btn(href="#" target="_blank" rel="noopener noreferrer" aria-label="VK")
						svg(aria-hidden="true").soc-btn__icon
							use(href="assets/icons/symbol/sprite.svg#vk-mono")

					a.soc-btns__item.soc-btn(href="#" target="_blank" rel="noopener noreferrer" aria-label="Telegram")
						svg(aria-hidden="true").soc-btn__icon
							use(href="assets/icons/symbol/sprite.svg#tg-mono")


	.header-bottom
		.container.header-bottom__container
			.header-bottom__first 
				button.header-bottom__burger.burger.jsMobileMenuBtnToggle(type='button' aria-label='Меню сайта')
					span.burger-line

				a.header-bottom__logo(href="/verstka/")
					img.header-bottom__img(src="assets/images/logo.png", alt="Исцеление - медико-психологический центр")

			nav.header-bottom__nav
				ul.header-nav
					li.header-nav__item
						a.header-nav__link(href="#") Автобусные туры
					li.header-nav__item
						a.header-nav__link(href="#") Прием в Волгограде
					li.header-nav__item
						a.header-nav__link(href="#") Волгоградским школьникам
					li.header-nav__item
						a.header-nav__link(href="#") Бронирование отелей

			button.header-bottom__feedback.btn(data-popup="callback") Получить консультацию