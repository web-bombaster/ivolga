.selected-tours
	.selected-tours__container.container 
		.selected-tours__slider.stours-slider.swiper.js-stours-slider
			.stours-slider__wrapper.swiper-wrapper

				.stours-slider__item.stours-slide.swiper-slide
					img.stours-slide__img(src="assets/images/stours-slide-01.jpg", alt="")
					.stours-slide__box
						.stours-slide__top.badges
							span.badge
								svg(aria-hidden="true").badge-icon
									use(href="assets/icons/symbol/sprite.svg#lightning")
								| Новинка
