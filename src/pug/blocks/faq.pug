mixin faq-item(title, content)
	li.faq-list__item.faq-item
		.faq-item__title= title
		.faq-item__content= content

.faq
	.faq-container.container 
		.faq-box.section-col
			h2.h2.faq-title Частые вопросы
			ul.faq-list
				+faq-item(
					'Как подобрать подходящий тур?',
					'В договоре закреплены автомобиль, сроки, этапы работы, итоговая стоимость и наша ответственность на каждом шаге.'
				)

				+faq-item(
					'Можно ли забронировать только отель?',
					'В договоре закреплены автомобиль, сроки, этапы работы, итоговая стоимость и наша ответственность на каждом шаге.'
				)

				+faq-item(
					'Организуете ли вы приём туристов в Волгограде?',
					'В договоре закреплены автомобиль, сроки, этапы работы, итоговая стоимость и наша ответственность на каждом шаге.'
				)

				+faq-item(
					'Как оплатить тур?',
					'В договоре закреплены автомобиль, сроки, этапы работы, итоговая стоимость и наша ответственность на каждом шаге.'
				)

				+faq-item(
					'Можно ли изменить или отменить бронирование?',
					'В договоре закреплены автомобиль, сроки, этапы работы, итоговая стоимость и наша ответственность на каждом шаге.'
				)

				+faq-item(
					'Условия для турагентств и корпоративных клиентов',
					'В договоре закреплены автомобиль, сроки, этапы работы, итоговая стоимость и наша ответственность на каждом шаге.'
				)