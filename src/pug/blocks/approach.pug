mixin approachItem(title, image)
	.approach__item.swiper-slide
		.approach__name-box
			p.approach__name= title
			a.approach__link(href="#") Подробнее
		.approach__image
			img(src=`assets/images/${image}`, alt="", loading="lazy")

section.approach
	.approach__container.container
		.approach__box.section-col

			h2.h2.approach-title Путешествия с особым подходом

			.slider-wrapper
				.approach__slider.swiper.js-approach-slider
					.approach__list.swiper-wrapper
						+approachItem('Корпоративным клиентам и MICE', 'approach-01.png')
						+approachItem('Оформить тур в подарок', 'approach-02.png')
						+approachItem('Театр иммерсивных экскурсий Step by Step', 'approach-03.png')
						+approachItem('Школа путешествий по России', 'approach-04.png')
						+approachItem('Заказ автобусов и трансферов', 'approach-05.png')

				.approach__nav.slider-nav
					.approach__nav-box.slider-nav__box
						.approach__prev.slider-nav__prev
						.approach__next.slider-nav__next
