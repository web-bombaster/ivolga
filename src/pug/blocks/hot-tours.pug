include ../mixins/hot-tour.pug
include ../mixins/tag-tour.pug
include ../mixins/badge-item.pug

section.hot-tours
	.hot-tours__container.container
		.hot-tours__box.section-grid
			h2.h2.hot-tours-title Горящие туры

			.hot-tours__slider-wrapper.slider-wrapper
				.hot-tours__slider.swiper.js-hot-tours-slider
					ul.hot-tours-list.swiper-wrapper

						+hot-tour(
							'assets/images/hot-tours-01.jpg',
							'Тур в Коломну',
							'Три вкуса истории',
							[
								{text: 'Горящий', accent: true, icon: 'fire'},
								{text: 'Купили более 12 раз'}
							],
							[
								{text: 'Кавказ', icon: 'geo'},
								{text: 'Автобусный', icon: 'bus'}
							],
							[
								{date: '7 сен — 11 сен', period: '4 дня / 3 ночи'},
								{date: '10 сен — 15 сен', moreDates: 11}
							],
							'20 550 ₽',
							'28 550 ₽'
						)

						+hot-tour(
							'assets/images/hot-tours-02.jpg',
							'Тур в Коломну',
