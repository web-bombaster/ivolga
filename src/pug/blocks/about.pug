mixin about-item(icon, title, description = '', iconMod = false)
	.about-item
		img.about-item__icon(
			class=iconMod ? 'about-item__icon--mod' : ''
			src=icon
			alt=""
		)
		.about-item__info
			span.about-item__title= title
			if description
				p.about-item__descr!= description

section.about
	.about-container.container
		.about-box
			.about-info
				.about-info__top
					h2.h3.about-title И-Волга — туроператор из Волгограда, который работает на вас
					.about-descr
						p Более 20 лет успешной работы на рынке туристических услуг и тысячи счастливых и отлично отдохнувших туристов‑отличный результат для нашей команды, которая сложилась из любви каждого из нас к путешествиям.
						p Отдых и путешествия, познания нового и неизведанного-наша страсть, наша жизнь и в итоге наша любимая работа
				a.about-btn.btn.btn-fill
					| Подробнее о компании
					svg.btn-icon(aria-hidden="true")
						use(href="assets/icons/symbol/sprite.svg#arrow-right")
			.about-items
				+about-item(
					'assets/images/about-01.svg',
					'Мы в реестре туроператоров',
					'ООО «Туристическая компания И‑Волга» <span>РТО 008863</span>'
				)

				+about-item(
					'assets/images/about-02.svg',
					'Мы в Российском Союзе Туриндустрии'
				)

				+about-item(
					'assets/images/about-03.svg',
					'Сертификат Роскачества'
				)

				+about-item(
					'assets/images/about-04.svg',
					'Стратегический партнер',
					'',
					true
				)